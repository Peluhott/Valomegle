# Copy this file to `.env` and fill in real values before running `docker compose up --build`.
# `.env` is gitignored and never committed.
#
# Docker Compose auto-loads this file — no database service is provisioned here,
# DB_URL must point at Neon.tech (or any reachable Postgres).

DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
JWT_SECRET=change-me-to-a-secret-at-least-32-characters

# Comma-separated list of origins allowed to call the API / connect via WebSocket
ALLOWED_ORIGINS=http://localhost:5173

# Read by the frontend container at startup (written into config.js) — change
# and restart the container to point at a new backend, no image rebuild needed.
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080

# Optional overrides for the matchmaking Redis connection; docker-compose already
# defaults the backend to the "redis" service on the compose network without these.
REDIS_HOST=redis
REDIS_PORT=6379
